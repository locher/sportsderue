# Sports de rue — variante Caddy du contrat de service.
#
# La production tourne sur o2switch : le fichier de référence est
# `deploy/o2switch/.htaccess`, et celui-ci doit dire exactement la même chose.
#
# Caddy est le chemin le plus court sur un serveur qu'on administre : il obtient et
# renouvelle le certificat tout seul, compresse tout seul (gzip + zstd), connaît
# `.webmanifest`, et n'a pas le piège d'héritage des en-têtes de nginx. Il ne reste à
# écrire que ce qui est propre au projet — les règles de cache et les en-têtes de sécurité.
#
# Vérifier après mise en ligne : npm run verifie-deploiement -- https://mon-site.fr

sportsderue.example.fr {
	root * /var/www/sportsderue

	encode zstd gzip

	# --- En-têtes de sécurité, identiques au `.htaccess` de production ---------------
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://data.geopf.fr https://equipements.sports.gouv.fr https://eu.i.posthog.com"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Retirer `preload` si le domaine n'est pas réellement soumis à la liste de
		# préchargement : c'est difficile à défaire.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Caddy annonce sa présence par défaut : inutile de le dire.
		-Server
	}

	# --- Fichiers à empreinte : leur nom change avec leur contenu ---------------------
	@empreinte path /assets/* /workbox-*.js
	header @empreinte Cache-Control "public, max-age=31536000, immutable"

	# --- Fichiers à nom stable : ce sont eux qui annoncent une nouvelle version -------
	# Un cache ici et l'application installée reste figée, sans rien signaler.
	@stables path /sw.js /index.html /manifest.webmanifest /
	header @stables Cache-Control "public, max-age=0, must-revalidate"

	# Repli page unique.
	try_files {path} /index.html
	file_server
}
