# Sports de rue — configuration de production (o2switch : cPanel, Apache/LiteSpeed).
#
# **C'est le fichier de référence du contrat de service.** Le site est hébergé sur un
# mutualisé o2switch, où il n'y a aucun accès à la configuration du serveur : tout passe
# par `.htaccess`. `deploy/Caddyfile` et `deploy/nginx/` restent dans le dépôt comme
# variantes pour un autre serveur, mais c'est ici que se joue ce qui est réellement servi
# — les trois doivent dire la même chose.
#
# Où le poser : à la **racine publique** du domaine (`public_html/` par défaut), à côté du
# contenu de `dist/`. Le workflow `.github/workflows/deploiement.yml` s'en charge à chaque
# étiquette de version, en le copiant dans `dist/` **après** le build — sinon le service
# worker le précacherait.
#
# Bonne nouvelle face à nginx : Apache **cumule** les en-têtes des portées imbriquées au
# lieu de les remplacer. Les en-têtes de sécurité déclarés une fois ici s'appliquent donc
# aussi aux fichiers qui redéfinissent leur `Cache-Control`, et il n'y a pas de fichier à
# réinclure partout.
#
# Ce que o2switch fournit et qu'il ne faut pas redéclarer : le certificat (AutoSSL) et la
# compression (LiteSpeed compresse seul). Ce qu'il ne fournit pas : la redirection vers
# HTTPS, HSTS, et tout ce qui suit.
#
# Non éprouvé localement : aucun Apache n'a pu être exécuté dans l'environnement de
# développement. C'est l'arbitre qui tranche, contre le site réellement servi — et le
# workflow de déploiement le lance tout seul à la fin de chaque mise en ligne :
#   npm run verifie-deploiement -- https://sportsderue.fr

Options -Indexes -MultiViews
DirectoryIndex index.html

# --- 1. HTTPS, puis un seul domaine canonique ----------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Le service worker et la géolocalisation exigent un contexte sécurisé : sans cette
  # redirection, une arrivée en `http://` donne une application muette et sans mise à jour.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Un seul domaine canonique. cPanel crée `www.` en même temps que le domaine, donc deux
  # origines répondent d'office — et deux origines valent deux service workers, deux
  # installations et deux caches. Comme aucun hôte n'est écrit en dur dans le code,
  # `share()` fabrique ses liens sur l'origine courante : sans cette redirection, une
  # arrivée par `www.` ferait circuler des liens sur le mauvais domaine, indéfiniment.
  RewriteCond %{HTTP_HOST} ^www\.sportsderue\.fr$ [NC]
  RewriteRule ^ https://sportsderue.fr%{REQUEST_URI} [R=301,L]

  # Repli page unique. L'état de la vue vit dans l'URL (`lat`, `lng`, `z`, `s`, `f`, `e`) :
  # un lien partagé doit rendre l'accueil, pas un 404. Les deux conditions laissent passer
  # ce qui existe vraiment sur le disque, `/data/playgrounds/*.json` compris.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# --- 2. Types MIME -------------------------------------------------------------------
# `.webmanifest` est le seul que le serveur ne connaît pas d'office ; les polices sont
# auto-hébergées, donc `.woff2` passe par ici aussi.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# --- 3. Compression ------------------------------------------------------------------
# LiteSpeed compresse seul, mais rien ne le garantit dans le temps, et c'est typiquement
# ce qui casse sans se voir : les 936 ko de MapLibre partiraient bruts au lieu de ~243 ko
# sans que personne ne le remarque depuis une fibre.
# Ni les `.woff2` ni les images : déjà compressés, les repasser ne brûle que du processeur.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
</IfModule>

# --- 4. Règles de cache --------------------------------------------------------------
# `mod_expires` peut être actif par défaut chez l'hébergeur et poserait son propre
# `Cache-Control` par-dessus : on le neutralise pour ne garder qu'une seule autorité.
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>
  # Fichiers à empreinte : leur nom change avec leur contenu, ils peuvent être gardés pour
  # toujours. `<FilesMatch>` ne sait pas viser un répertoire, d'où le drapeau posé sur
  # l'URL demandée pour `/assets/`.
  SetEnvIf Request_URI "^/assets/" EMPREINTE
  Header always set Cache-Control "public, max-age=31536000, immutable" env=EMPREINTE

  <FilesMatch "^workbox-.*\.js$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fichiers à nom stable : ce sont eux qui annoncent qu'il y a du neuf. Un `max-age` sur
  # l'un des trois et l'application installée reste figée sur son ancienne version — sans
  # rien signaler, elle continue de fonctionner. C'est le symptôme signalé depuis un
  # téléphone en août 2026, celui qui obligeait à vider le cache à la main.
  # `sw.js` en premier : c'est le seul fichier que l'application réinterroge d'elle-même.
  <FilesMatch "^(sw\.js|index\.html|manifest\.webmanifest)$">
    Header always set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # `/` passe par `DirectoryIndex` : le drapeau garantit la même règle sur la racine, sans
  # dépendre de la façon dont le serveur résout l'index.
  SetEnvIf Request_URI "^/$" RACINE
  Header always set Cache-Control "public, max-age=0, must-revalidate" env=RACINE
</IfModule>

# --- 5. En-têtes de sécurité -----------------------------------------------------------
# `always` les pose y compris sur les réponses d'erreur (404, 5xx).
#
# `connect-src` énumère les trois seuls services appelés depuis le navigateur : les deux
# API de l'État, et l'ingestion de la mesure d'audience (`eu.i.posthog.com`, instance
# européenne). Rien d'autre ne doit y entrer sans raison — et une source de données
# oubliée ici voit ses appels refusés, ce qui est bien le but. Deux choses qui n'y sont
# volontairement pas : `eu-assets.i.posthog.com`, parce que PostHog est configuré pour ne
# charger aucun script à l'exécution (`disable_external_dependency_loading`), et donc
# aucune ligne de `script-src` non plus. Changer `VITE_POSTHOG_HOST` au build impose de
# changer cette ligne, ici et dans les deux variantes de `deploy/`.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://data.geopf.fr https://equipements.sports.gouv.fr https://eu.i.posthog.com"

  # Doublon assumé de `frame-ancestors`, pour les navigateurs qui ne lisent que celui-ci.
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  # Les URL portent la position et l'équipement consulté, et l'application ouvre des liens
  # vers Google Maps, Apple Maps et OpenStreetMap : ils ne doivent emporter que l'origine.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # HSTS n'est fourni par personne ici, il faut le déclarer — et il compte d'autant plus
  # que `.fr` n'est pas un domaine de premier niveau préchargé (contrairement à `.app`, où
  # le navigateur force HTTPS de lui-même). Sans cet en-tête, la toute première visite
  # peut partir en clair. `preload` n'est à ajouter qu'en soumettant réellement le domaine
  # à la liste de préchargement : c'est très difficile à défaire, donc absent par défaut.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Rien à gagner à annoncer la version du serveur.
  Header always unset X-Powered-By
</IfModule>
